{
  "name": "obscura",
  "version": "1.0.0",
  "description": "Dependency security workspace on Cloudflare Workers, D1, and R2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply dope-security --local",
    "db:migrate:remote": "wrangler d1 migrations apply dope-security --remote",
    "deploy": "npm run build && wrangler deploy",
    "package:landing": "node scripts/package-landing.mjs",
    "prebuild": "node scripts/package-landing.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "private": true
}
